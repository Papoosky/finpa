# === Required ===
# IP LAN del servidor (la que ven los dispositivos en tu red)
SERVER_IP=192.168.1.100
# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=
# PostgreSQL password — choose a strong password
POSTGRES_PASSWORD=

# Hermes Agent service-to-service token. Generate: openssl rand -hex 32
  HERMES_SERVICE_TOKEN=

# === Optional ===
# Secret for POST /admin/users endpoint (create users without public registration)
# ADMIN_SECRET=
# Set to "true" to allow public registration (default: false in production)
# REGISTRATION_ENABLED=false
# Google Sheets spreadsheet ID for transaction sync
# GOOGLE_SHEETS_ID=
# PostgreSQL user and database name (default: finpa)
# POSTGRES_USER=finpa
# POSTGRES_DB=finpa
# Set to "development" to enable Swagger UI (default: production)
# ENV=production
# Token lifetimes
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
