{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finpa-web",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "finpa.pzuni.com",
      "custom_domain": true
    }
  ]
}
